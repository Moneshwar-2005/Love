*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Environment configurations and secrets
.env
.env.local
.env.*.local
*.secrets
secrets/

# Database files, journals and local vector dumps
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
*.db-journal
database/*.db
database/*.sqlite
database/*.sqlite3
database/*.db-shm
database/*.db-wal
database/*.db-journal
database/vectors/
database/backups/

# Model checkpoints and weights (store in external storage / release buckets)
models/*.pt
models/*.pth
models/*.bin
models/*.onnx
models/*.safetensors
models/*.gguf
models/checkpoints/

# Test and coverage artifacts
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# Logs and runtime artifacts
logs/
*.log
*.pid
*.tmp
love_*.txt

# Node / Dependency directories across all subprojects
node_modules/
**/node_modules/
web/node_modules/
desktop/node_modules/
mobile/node_modules/

