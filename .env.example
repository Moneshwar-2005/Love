# ==============================================================================
# LOVE — Personal AI Assistant Environment Configuration Template
# Copy this file to '.env' and adjust values for your environment.
# Never commit real credentials or secrets to version control.
# ==============================================================================

# Application Metadata
APP_NAME="LOVE Personal AI Assistant"
APP_ENV="development"
APP_VERSION="0.2.0"
DEBUG=true

# Server Configuration
HOST="127.0.0.1"
PORT=8000
WORKERS=1
RELOAD=true

# Security & Cryptography
SECRET_KEY="generate-a-secure-random-32-character-secret-key-for-production"
JWT_SECRET_KEY=""
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_ISSUER="love-assistant"
JWT_AUDIENCE="love-client"

# Registration & Initial Owner Setup
ALLOW_OPEN_REGISTRATION=false
FIRST_OWNER_SETUP_TOKEN=""
PASSWORD_MIN_LENGTH=8

# Rate Limiting
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:8080", "tauri://localhost"]

# Database Configuration
DATABASE_URL="sqlite+aiosqlite:///./database/love.db"
DATABASE_ECHO=false

# Logging Configuration
LOG_LEVEL="INFO"
LOG_FORMAT="text"
