# ==============================================================================
# LOVE — Personal AI Assistant Environment Configuration Template
# Copy this file to '.env' and adjust values for your environment.
# Never commit real credentials or secrets to version control.
# ==============================================================================

# Application Metadata
APP_NAME="LOVE Personal AI Assistant"
APP_ENV="development"
APP_VERSION="0.1.0"
DEBUG=true

# Server Configuration
HOST="127.0.0.1"
PORT=8000
WORKERS=1
RELOAD=true

# Security & CORS
SECRET_KEY="generate-a-secure-random-32-character-secret-key-for-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:8080", "tauri://localhost"]

# Database Configuration
# Local development default: SQLite async
DATABASE_URL="sqlite+aiosqlite:///./database/love.db"
# Production example: PostgreSQL async
# DATABASE_URL="postgresql+asyncpg://love_user:love_password@localhost:5432/love_db"
DATABASE_ECHO=false

# Logging Configuration
LOG_LEVEL="INFO"
LOG_FORMAT="text"

# Future Integration Placeholders (Do not populate in Phase 01)
# LLM_PROVIDER="local"
# LLM_MODEL_PATH="models/"
# VOICE_IDENTITY="indian_english_female"
