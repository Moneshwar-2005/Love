# ==============================================================================
# LOVE — Personal AI Assistant Environment Configuration Template
# Copy this file to '.env' and adjust values for your environment.
# Never commit real credentials or secrets to version control.
# ==============================================================================

# Application Metadata
APP_NAME="LOVE Personal AI Assistant"
APP_ENV="development"
APP_VERSION="0.2.0"
DEBUG=true

# Server Configuration
HOST="127.0.0.1"
PORT=8000
WORKERS=1
RELOAD=true

# Security & Cryptography
SECRET_KEY="generate-a-secure-random-32-character-secret-key-for-production"
JWT_SECRET_KEY=""
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_ISSUER="love-assistant"
JWT_AUDIENCE="love-client"

# Registration & Initial Owner Setup
ALLOW_OPEN_REGISTRATION=false
FIRST_OWNER_SETUP_TOKEN=""
PASSWORD_MIN_LENGTH=8

# Rate Limiting
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:8080", "tauri://localhost"]

# Database Configuration
DATABASE_URL="sqlite+aiosqlite:///./database/love.db"
DATABASE_ECHO=false

# Logging Configuration
LOG_LEVEL="INFO"
LOG_FORMAT="text"

# ==============================================================================
# Universal Intelligence Layer & Model Routing (Phase 03)
# ==============================================================================
DEFAULT_PROVIDER="auto"
DEFAULT_MODEL="auto"
ROUTING_PREFERENCE="auto"
LOCAL_ONLY_MODE=false

# Local AI (Ollama Runtime)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_TIMEOUT_SECONDS=60

# Cloud Providers (Leave empty to disable)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"

ANTHROPIC_API_KEY=""
ANTHROPIC_BASE_URL="https://api.anthropic.com/v1"

GEMINI_API_KEY=""
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"

OPENAI_COMPATIBLE_API_KEY=""
OPENAI_COMPATIBLE_BASE_URL=""

# Context Window & Timeouts
INTELLIGENCE_CONTEXT_MAX_MESSAGES=20
INTELLIGENCE_CONTEXT_MAX_TOKENS=4096
INTELLIGENCE_REQUEST_TIMEOUT_SECONDS=60

# ==============================================================================
# Persistent Personal Memory & Vector Retrieval (Phase 04)
# ==============================================================================
MEMORY_EMBEDDING_PROVIDER="auto"
MEMORY_OLLAMA_EMBEDDING_MODEL="qwen2.5:1.5b"
MEMORY_VECTOR_STORE_TYPE="local"
MEMORY_VECTOR_STORAGE_PATH="database/vectors"
MEMORY_ALLOW_CLOUD_EMBEDDINGS=false
MEMORY_RETRIEVAL_TOP_K=5
MEMORY_RETRIEVAL_MIN_SCORE=0.30
MEMORY_AUTO_EXTRACT_ENABLED=true
MEMORY_DEDUPLICATION_THRESHOLD=0.85

# ==============================================================================
# Universal Work Intelligence & Safe Tool Orchestration (Phase 05)
# ==============================================================================
WORKSPACE_ROOT="workspace"
TOOL_EXECUTION_TIMEOUT_SECONDS=30
TOOL_REQUIRE_CONFIRMATION_FOR_MEDIUM_RISK=true
RESEARCH_PROVIDER="mock"

# ==============================================================================
# Voice Engine, Speech Recognition & Wake Word (Phase 06)
# ==============================================================================
VOICE_ENABLED=true
VOICE_STT_PROVIDER="faster_whisper"
VOICE_WHISPER_MODEL="base"
VOICE_WHISPER_DEVICE="auto"
VOICE_WHISPER_COMPUTE_TYPE="int8"
VOICE_WHISPER_LANGUAGE="en"
VOICE_STT_TIMEOUT_SECONDS=30

# Wake Word (Opt-in only, never true by default)
VOICE_WAKE_WORD_ENABLED=false
VOICE_WAKE_WORD_PROVIDER="openwakeword"
VOICE_WAKE_WORD_PHRASE="Hey LOVE"
VOICE_WAKE_WORD_THRESHOLD=0.5

# Text-to-Speech Providers (Leave keys empty to use local/mock fallback)
VOICE_TTS_PROVIDER="auto"
VOICE_TTS_LOCAL_FALLBACK=true

# Azure Speech (Primary Cloud)
VOICE_AZURE_SPEECH_KEY=""
VOICE_AZURE_SPEECH_REGION=""
VOICE_AZURE_VOICE_NAME="en-IN-NeerjaNeural"

# ElevenLabs (Alternative Cloud)
VOICE_ELEVENLABS_API_KEY=""
VOICE_ELEVENLABS_VOICE_ID=""

# Piper (Local Fallback)
VOICE_PIPER_BINARY_PATH=""
VOICE_PIPER_MODEL_PATH=""
VOICE_PIPER_CONFIG_PATH=""

# Voice Personality & Audio Constraints
VOICE_DEFAULT_PERSONALITY="love_classic"
VOICE_AUDIO_MAX_DURATION_SECONDS=120
VOICE_AUDIO_MAX_FILE_SIZE_BYTES=15728640
VOICE_AUDIO_TEMP_DIR="workspace/audio_temp"
VOICE_RETAIN_AUDIO=false
