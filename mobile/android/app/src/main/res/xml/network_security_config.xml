<?xml version="1.0" encoding="utf-8"?>
<!--
    LOVE Production Network Security Configuration.
    Enforces strict TLS verification against system-trusted Certificate Authorities.
    Explicitly prohibits cleartext HTTP traffic across all domains.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
